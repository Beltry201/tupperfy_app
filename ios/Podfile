# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'tupperfy_app' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'tupperfy_appTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Fix deployment target warnings for all pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end

    # Fix Xcode 26 duplicate symbol errors: add classic linker to app xcconfig only
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |variant, xcconfig|
        xcconfig_path = aggregate_target.client_root + aggregate_target.xcconfig_relative_path(variant)
        xcconfig_content = File.read(xcconfig_path)
        unless xcconfig_content.include?('-ld_classic')
          updated = xcconfig_content.gsub(/(OTHER_LDFLAGS = .*)/) { "#{$1} -Wl,-ld_classic" }
          File.write(xcconfig_path, updated)
        end
      end
    end
  end
end
